[Unit]
Description=Script that makes various things happen based on mqtt messages
After=network.target

[Service]
User=koin
Group=koin
Restart=always
RestartSec=10s
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="VIRTUAL_ENV=/opt/kelderapi/env"
Environment="PATH=$VIRTUAL_ENV/bin:/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin:$PATH"
WorkingDirectory=/opt/kelderapi
ExecStart=/opt/kelderapi/env/bin/python3 -u /opt/kelderapi/scripts/mqtt2other.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
